{
  "openapi": "3.0.0",
  "info": {
    "title": "Samridhya Blog API",
    "description": "A simplified blog API built with Firebase Functions and Firestore",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@samridhya.com"
    }
  },
  "servers": [
    {
      "url": "https://us-central1-your-project-id.cloudfunctions.net/api",
      "description": "Production server"
    },
    {
      "url": "http://localhost:5001/your-project-id/us-central1/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Check if the API is running",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Blog API is running"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/blog/posts": {
      "get": {
        "summary": "Get all blog posts",
        "description": "Retrieve all blog posts with optional filtering and pagination",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by post status",
            "schema": {
              "type": "string",
              "enum": ["draft", "published"]
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by category",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "description": "Filter by featured status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of posts to return",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of posts to skip",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of blog posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "posts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/BlogPost"
                          }
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new blog post",
        "description": "Create a new blog post",
        "tags": ["Posts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlogPostCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Blog post created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BlogPost"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation failed"
          }
        }
      }
    },
    "/api/blog/posts/{id}": {
      "get": {
        "summary": "Get blog post by ID",
        "description": "Retrieve a specific blog post by its ID",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Blog post ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blog post found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BlogPost"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Blog post not found"
          }
        }
      },
      "put": {
        "summary": "Update blog post",
        "description": "Update an existing blog post",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Blog post ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlogPostUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blog post updated successfully"
          },
          "404": {
            "description": "Blog post not found"
          }
        }
      },
      "delete": {
        "summary": "Delete blog post",
        "description": "Delete a blog post",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Blog post ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blog post deleted successfully"
          },
          "404": {
            "description": "Blog post not found"
          }
        }
      }
    },
    "/api/blog/posts/slug/{slug}": {
      "get": {
        "summary": "Get blog post by slug",
        "description": "Retrieve a specific blog post by its slug",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Blog post slug",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blog post found"
          },
          "404": {
            "description": "Blog post not found"
          }
        }
      }
    },
    "/api/blog/search": {
      "get": {
        "summary": "Search blog posts",
        "description": "Search blog posts by query",
        "tags": ["Search"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results to return",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          },
          "400": {
            "description": "Search query is required"
          }
        }
      }
    },
    "/api/blog/posts/{id}/like": {
      "post": {
        "summary": "Like a blog post",
        "description": "Increment the like count for a blog post",
        "tags": ["Analytics"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Blog post ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post liked successfully"
          }
        }
      }
    },
    "/api/blog/categories": {
      "get": {
        "summary": "Get all categories",
        "description": "Retrieve all blog categories with post counts",
        "tags": ["Categories"],
        "responses": {
          "200": {
            "description": "List of categories"
          }
        }
      }
    },
    "/api/blog/tags": {
      "get": {
        "summary": "Get all tags",
        "description": "Retrieve all blog tags",
        "tags": ["Tags"],
        "responses": {
          "200": {
            "description": "List of tags"
          }
        }
      }
    },
    "/api/blog/featured": {
      "get": {
        "summary": "Get featured posts",
        "description": "Retrieve featured blog posts",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of posts to return",
            "schema": {
              "type": "integer",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of featured posts"
          }
        }
      }
    },
    "/api/blog/popular": {
      "get": {
        "summary": "Get popular posts",
        "description": "Retrieve popular blog posts by view count",
        "tags": ["Posts"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of posts to return",
            "schema": {
              "type": "integer",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of popular posts"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlogPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly slug"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "content": {
            "type": "string",
            "description": "Post content"
          },
          "author": {
            "type": "string",
            "description": "Author name"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Post status"
          },
          "featuredImage": {
            "type": "string",
            "description": "Featured image URL"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Post tags"
          },
          "category": {
            "type": "string",
            "description": "Post category"
          },
          "readTime": {
            "type": "string",
            "description": "Estimated reading time"
          },
          "featured": {
            "type": "boolean",
            "description": "Whether post is featured"
          },
          "views": {
            "type": "integer",
            "description": "View count"
          },
          "likes": {
            "type": "integer",
            "description": "Like count"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Publication timestamp"
          }
        },
        "required": ["title", "slug", "content", "author", "status", "category"]
      },
      "BlogPostCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly slug (auto-generated if not provided)"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "content": {
            "type": "string",
            "description": "Post content"
          },
          "author": {
            "type": "string",
            "description": "Author name"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Post status"
          },
          "featuredImage": {
            "type": "string",
            "description": "Featured image URL"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Post tags"
          },
          "category": {
            "type": "string",
            "description": "Post category"
          },
          "readTime": {
            "type": "string",
            "description": "Estimated reading time (auto-calculated if not provided)"
          },
          "featured": {
            "type": "boolean",
            "description": "Whether post is featured"
          }
        },
        "required": ["title", "content", "author", "status", "category"]
      },
      "BlogPostUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly slug"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "content": {
            "type": "string",
            "description": "Post content"
          },
          "author": {
            "type": "string",
            "description": "Author name"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Post status"
          },
          "featuredImage": {
            "type": "string",
            "description": "Featured image URL"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Post tags"
          },
          "category": {
            "type": "string",
            "description": "Post category"
          },
          "readTime": {
            "type": "string",
            "description": "Estimated reading time"
          },
          "featured": {
            "type": "boolean",
            "description": "Whether post is featured"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "Posts",
      "description": "Blog post operations"
    },
    {
      "name": "Search",
      "description": "Search functionality"
    },
    {
      "name": "Analytics",
      "description": "Analytics and engagement"
    },
    {
      "name": "Categories",
      "description": "Category management"
    },
    {
      "name": "Tags",
      "description": "Tag management"
    }
  ]
} 